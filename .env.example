# QuickPNG-To256Permill 変換設定
# Claude・scripts/local_fallback.sh の両方がこの値を参照する

# 入力PSDの想定解像度(dpi)。実ファイルと不一致の場合は警告して続行
INPUT_DPI=72

# 出力PNGに付与する解像度メタデータ(dpi)
OUTPUT_DPI=350

# カンバスpx縮小率(%)。25.6 = 256‰
SCALE_PERCENT=25.6

# --- 任意の後段: iLoveAPI (iLoveIMG) compressimage で出力PNGをさらに圧縮する ---
# 1=有効 / 0=無効。有効時は変換スクリプトの末尾で scripts/iloveapi_compress.py が自動実行される。
ILOVEAPI_COMPRESS=0
# https://www.iloveapi.com/ で発行した Public key（無料枠 月2,500クレジット。1画像=1クレジット目安）
ILOVEAPI_PUBLIC_KEY=
# 圧縮強度: low / recommended / extreme
ILOVEAPI_LEVEL=recommended
